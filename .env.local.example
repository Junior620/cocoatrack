# CocoaTrack V2 - Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Key (Admin operations - NEVER expose to client)
# Get this from your Supabase project dashboard > Settings > API > service_role key
# WARNING: This key bypasses Row Level Security - use only server-side
SUPABASE_SERVICE_KEY=your-service-role-key-here

# For local development with Supabase CLI:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<get from 'supabase status'>

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable Maps JavaScript API in your Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry Configuration (Error Tracking)
# Get your DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Receipt Import Feature (Requirements: 13.1, 13.2)
# =============================================================================

# OCR Service Provider
# Controls which OCR provider is used for automatic text extraction from PDFs.
# When set to 'none', the "Extraction automatique (OCR)" option is hidden and
# only manual entry is available.
# Options: 'none' (default), 'tesseract', 'google', 'aws'
OCR_PROVIDER=none

# Tesseract OCR (Local - no external service required)
# Install the package: npm install tesseract.js
# No additional environment variables needed.

# Google Cloud Vision OCR
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-credentials.json

# AWS Textract OCR
# Get credentials from: https://console.aws.amazon.com/iam/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OCR Timeout in milliseconds (Requirement: 13.4)
# If extraction exceeds this limit, the user is prompted to enter data manually.
# Default: 30000 (30 seconds)
# OCR_TIMEOUT=30000

# Storage Configuration for Collection Receipts (Requirements: 9.1, 9.3)
# The 'collection-receipts' bucket is created automatically via migration
# 20260324000002_storage_collection_receipts.sql.
#
# Storage path format: {cooperative_id}/receipts/{receipt_number}/{uuid}_{filename}.pdf
# Max file size: 10MB (enforced at bucket level and in application code)
# Allowed MIME types: application/pdf only
#
# No additional environment variables are required — storage uses the
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_KEY values defined above.

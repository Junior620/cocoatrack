# CocoaTrack V2 - Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Key (Admin operations - NEVER expose to client)
# Get this from your Supabase project dashboard > Settings > API > service_role key
# WARNING: This key bypasses Row Level Security - use only server-side
SUPABASE_SERVICE_KEY=your-service-role-key-here

# For local development with Supabase CLI:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<get from 'supabase status'>

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=
# For Static Images API (high-resolution parcelle images)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Maps Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable Maps JavaScript API in your Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry Configuration (Error Tracking)
# Get your DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Receipt Import Feature (Requirements: 13.1, 13.2)
# =============================================================================

# OCR Service Provider
# Controls which OCR provider is used for automatic text extraction from PDFs.
# When set to 'none', the "Extraction automatique (OCR)" option is hidden and
# only manual entry is available.
# Options: 'none' (default), 'tesseract', 'google', 'aws'
OCR_PROVIDER=none

# Tesseract OCR (Local - no external service required)
# Install the package: npm install tesseract.js
# No additional environment variables needed.

# Google Cloud Vision OCR
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-credentials.json

# AWS Textract OCR
# Get credentials from: https://console.aws.amazon.com/iam/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OCR Timeout in milliseconds (Requirement: 13.4)
# If extraction exceeds this limit, the user is prompted to enter data manually.
# Default: 30000 (30 seconds)
# OCR_TIMEOUT=30000

# Storage Configuration for Collection Receipts (Requirements: 9.1, 9.3)
# The 'collection-receipts' bucket is created automatically via migration
# 20260324000002_storage_collection_receipts.sql.
#
# Storage path format: {cooperative_id}/receipts/{receipt_number}/{uuid}_{filename}.pdf
# Max file size: 10MB (enforced at bucket level and in application code)
# Allowed MIME types: application/pdf only
#
# No additional environment variables are required — storage uses the
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_KEY values defined above.

# =============================================================================
# Google Earth Engine Configuration (Satellite Imagery Analysis)
# =============================================================================

# Google Earth Engine Service Account
# Get credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
# 1. Create a new Google Cloud project or use existing one
# 2. Enable Earth Engine API: https://console.cloud.google.com/apis/library/earthengine.googleapis.com
# 3. Create a service account with Earth Engine permissions
# 4. Download the JSON key file
# 5. Register for Earth Engine access: https://earthengine.google.com/signup

# Google Cloud Project ID (from your GCP project)
GOOGLE_EARTH_ENGINE_PROJECT_ID=your-gcp-project-id

# Service Account Email (from the JSON key file)
# Format: service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Service Account Private Key (from the JSON key file)
# Copy the entire "private_key" value including the BEGIN/END lines
# Note: In production, use a secrets manager instead of environment variables
GOOGLE_EARTH_ENGINE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# Alternative: Path to Service Account JSON Key File (for local development)
# If you prefer to use a file instead of copying the key, uncomment this:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Earth Engine API Configuration
# Rate limit tracking (optional - for monitoring API usage)
# GEE_API_RATE_LIMIT=250000
# GEE_API_RATE_LIMIT_WINDOW=86400000

# Sentinel-2 Configuration
# Default cloud cover threshold (0-100, default: 20)
# SENTINEL2_CLOUD_COVER_THRESHOLD=20

# Satellite Imagery Date Offset (in days)
# How many days in the past to search for imagery (default: 30)
# Example: 30 = search for imagery from 30 days ago
# This is useful because Sentinel-2 only has historical data, not future data
SATELLITE_IMAGERY_DAYS_OFFSET=30

# Cache Configuration for Satellite Data
# Redis connection string (optional - for server-side caching)
# If not provided, in-memory caching will be used
# REDIS_URL=redis://localhost:6379

# Satellite Data Storage Buckets
# These buckets are created automatically via migration
# Bucket names: satellite-imagery, ndvi-rasters, kml-exports, certification-reports
# No additional configuration required - uses Supabase Storage

# Development: Use Mock Imagery Service
# Set to 'true' to use synthetic satellite data for development without GEE setup
# Set to 'false' or remove to use real Google Earth Engine data
# Default: false (use real GEE data)
NEXT_PUBLIC_USE_MOCK_IMAGERY=false

# =============================================================================
# Cron Job Security
# =============================================================================

# Cron Secret (for securing cron job endpoints)
# Generate a random secret string for production
# This is used to authenticate requests to /api/cron/* endpoints
# Example: openssl rand -base64 32
CRON_SECRET=your-random-secret-string-here
